<!DOCTYPE html>

<html lang="ar"
      dir="rtl">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <meta name="description"
          content="@(ViewData["Description"] ?? "مركز بادرة للعلاج الطبيعي في بريدة")" />

    <meta name="theme-color"
          content="#121a19" />

    <title>
        @ViewData["Title"] - مركز بادرة للعلاج الطبيعي
    </title>


    <link rel="icon"
          type="image/png"
          href="~/images/logo.png"
          asp-append-version="true" />


    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

</head>


<body>

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="site-header">

        <div class="container header-inner">


            <!-- Logo -->

            <a class="brand"
               asp-controller="Home"
               asp-action="Index"
               aria-label="مركز بادرة للعلاج الطبيعي">

                <img src="~/images/logo.png"
                     asp-append-version="true"
                     alt="مركز بادرة للعلاج الطبيعي" />

                <div class="brand-text">

                    <strong>
                        مركز بادرة
                    </strong>

                    <span>
                        للعلاج الطبيعي
                    </span>

                </div>

            </a>


            <!-- Desktop Navigation -->

            <nav class="main-nav"
                 aria-label="القائمة الرئيسية">

                <a href="#home">
                    الرئيسية
                </a>

                <a href="#about">
                    عن المركز
                </a>

                <a href="#services">
                    خدماتنا
                </a>

                <a href="#journey">
                    رحلتك العلاجية
                </a>

                <a href="#specialists">
                    فريقنا
                </a>

                <a href="#reviews">
                    آراء المراجعين
                </a>

                <a href="#contact">
                    تواصل معنا
                </a>

            </nav>


            <!-- Header CTA -->

            <a href="#contact"
               class="header-cta">

                تواصل معنا

            </a>


            <!-- Mobile Menu Button -->

            <button type="button"
                    class="mobile-menu-btn"
                    id="mobileMenuBtn"
                    aria-label="فتح القائمة"
                    aria-expanded="false">

                <span></span>
                <span></span>
                <span></span>

            </button>

        </div>


        <!-- Mobile Navigation -->

        <nav class="mobile-nav"
             id="mobileNav"
             aria-label="القائمة المحمولة">

            <a href="#home">
                الرئيسية
            </a>

            <a href="#about">
                عن المركز
            </a>

            <a href="#services">
                خدماتنا
            </a>

            <a href="#journey">
                رحلتك العلاجية
            </a>

            <a href="#specialists">
                فريقنا
            </a>

            <a href="#reviews">
                آراء المراجعين
            </a>

            <a href="#contact">
                تواصل معنا
            </a>

        </nav>

    </header>


    <!-- =====================================================
         MAIN CONTENT
    ====================================================== -->

    <main id="home">

        @RenderBody()

    </main>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-grid">


                <div class="footer-brand">

                    <img src="~/images/logo.png"
                         asp-append-version="true"
                         alt="مركز بادرة للعلاج الطبيعي" />

                    <h3>
                        مركز بادرة للعلاج الطبيعي
                    </h3>

                    <p>
                        رعاية متخصصة تساعدك على استعادة
                        الحركة والعودة إلى حياتك بثقة.
                    </p>

                </div>


                <div>

                    <h4>
                        روابط سريعة
                    </h4>

                    <ul class="footer-links">

                        <li>
                            <a href="#about">
                                عن المركز
                            </a>
                        </li>

                        <li>
                            <a href="#services">
                                خدماتنا
                            </a>
                        </li>

                        <li>
                            <a href="#specialists">
                                فريقنا
                            </a>
                        </li>

                        <li>
                            <a href="#reviews">
                                آراء المراجعين
                            </a>
                        </li>

                    </ul>

                </div>


                <div>

                    <h4>
                        تواصل معنا
                    </h4>

                    <ul class="footer-contact">

                        <li>
                            <span>📍</span>
                            بريدة - القصيم
                        </li>

                        <li>
                            <span>📞</span>

                            <a href="tel:+966506522551">
                                0506522551
                            </a>

                        </li>

                        <li>
                            <span>✉️</span>

                            <a href="mailto:info@badra-center.com">
                                info@badra-center.com
                            </a>

                        </li>

                    </ul>

                </div>


                <div>

                    <h4>
                        ساعات العمل
                    </h4>

                    <p class="footer-hours">
                        السبت - الخميس
                        <br />
                        9:00 ص - 9:00 م
                    </p>

                    <p class="footer-hours">
                        الجمعة
                        <br />
                        مغلق
                    </p>

                </div>

            </div>


            <div class="footer-bottom">

                <span>
                    © @DateTime.Now.Year مركز بادرة للعلاج الطبيعي.
                    جميع الحقوق محفوظة.
                </span>

                <span>
                    تصميم وتطوير الموقع
                </span>

            </div>

        </div>

    </footer>


    <!-- =====================================================
         FLOATING WHATSAPP
    ====================================================== -->

    <a href="https://wa.me/966506522551"
       class="whatsapp-float"
       target="_blank"
       rel="noopener noreferrer"
       aria-label="التواصل عبر واتساب">

        <span>
            ☎
        </span>

    </a>


    <script src="~/js/site.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>