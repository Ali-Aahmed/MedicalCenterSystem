                    </a>

                </div>

            </div>


            <div class="map-frame">

                <iframe src="https://www.google.com/maps?q=مركز+بادرة+للعلاج+الطبيعي+بريدة&output=embed"
                        loading="lazy"
                        referrerpolicy="no-referrer-when-downgrade"
                        title="موقع مركز بادرة للعلاج الطبيعي على الخريطة">
                </iframe>

            </div>

        </div>

    </div>

</section>